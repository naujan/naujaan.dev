---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import '../styles/global.css';

interface Props {
  overlayHeader?: boolean;
  title?: string;
  description?: string;
}

const { overlayHeader = false, title = 'naujaan - Developer', description = 'My personal portfolio. Explore my blog and projects.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description}/>
    <meta name="keywords" content="developer, portfolio, Java, JavaScript,  IT">
    <meta name="author" content="Jan Pawłowicz"/>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="naujaan - portfolio" />
    <meta property="og:title" content="naujaan - portfolio" />
    <meta
      property="og:description"
      content="My personal portfolio. Explore my blog and projects."
    />
    <meta property="og:url" content="https://naujaan.dev/" />
    <meta property="og:image" content="https://naujaan.dev/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="naujaan - portfolio" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="naujaan - portfolio" />
    <meta
      name="twitter:description"
      content="My personal portfolio. Explore my blog and projects."
    />
    <meta name="twitter:image" content="https://naujaan.dev/og-image.png" />

    <title>{title}</title>
  </head>

  <body id="top" tabindex="-1" class:list={{ 'home-layout': overlayHeader }}>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />

    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>

<style>
  /* Layout owns header positioning; a scroll scene may supply animation values. */
  @media (min-width: 769px) and (prefers-reduced-motion: no-preference) {
    :global(body.home-layout > header) {
      position: absolute;
      inset: 0 0 auto;
      z-index: 10;
      width: 100%;
      transform: translateY(var(--header-shift, 0%)) scale(var(--header-scale, 1));
      transform-origin: top center;
      opacity: var(--header-opacity, 1);
    }
  }
</style>
