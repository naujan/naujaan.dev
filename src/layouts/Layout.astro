---
import Header from '../components/Header.astro';
import '../styles/global.css';

interface Props {
  overlayHeader?: boolean;
}

const { overlayHeader = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Naujaan - developer portfolio, projects and writing."
    />
    <title>naujaan - Developer</title>
  </head>

  <body class:list={{ 'home-layout': overlayHeader }}>
    <Header />

    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
