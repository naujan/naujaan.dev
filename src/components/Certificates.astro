---
import type { about } from '../lib/site';
interface Props { certificates: typeof about.certificates; }
const images = Astro.props.certificates.flatMap(item => item.image ? [item.image] : []);
---
{images.length > 0 && <ul class="certificates" aria-label="Certificates">
  {images.map((src, index) => <li>
    <a href={src} target="_blank" rel="noopener noreferrer" aria-label={'Open certificate ' + (index + 1) + ' in full size (new tab)'}>
      <img src={src} alt={'Certificate ' + (index + 1)} loading="lazy" decoding="async" />
    </a>
  </li>)}
</ul>}
<style>
  .certificates { display: grid; gap: 20px; list-style: none; margin: 40px 0 0; padding: 0; }
  li { min-width: 0; }
  a { display: block; padding: 8px; border: 1px solid var(--border); background: #ffffff04; border-radius: 4px; }
  a:hover { border-color: #9ab2ff; }
  a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
  img { display: block; width: 100%; height: auto; }
</style>
