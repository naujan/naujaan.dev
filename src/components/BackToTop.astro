<back-to-top><a href="#top" aria-label="Back to top" title="Back to top">↑</a></back-to-top>
<style>
  back-to-top { position: fixed; bottom: 24px; right: 24px; z-index: 20; }
  a { display: grid; place-items: center; width: 48px; height: 48px; background: #151725; color: var(--text); border: 1px solid #ffffff30; border-radius: 50%; text-decoration: none; font-size: 22px; box-shadow: 0 8px 32px #0005; }
  a:hover { background: var(--accent); }
  back-to-top[hidden] { display: none; }
</style>
<script>
  class BackToTop extends HTMLElement {
    private observer?: IntersectionObserver;
    private handleClick = (event: MouseEvent) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const top = document.getElementById('top');
      if (!top) return;
      event.preventDefault();
      top.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth' });
      history.replaceState(null, '', location.pathname + location.search);
    };
    connectedCallback() {
      this.addEventListener('click', this.handleClick);
      const hero = document.getElementById('hero') ?? document.querySelector('header');
      if (hero) {
        this.observer = new IntersectionObserver(entries => { this.hidden = entries[0].isIntersecting; });
        this.observer.observe(hero);
      }
    }
    disconnectedCallback() { this.observer?.disconnect(); this.removeEventListener('click', this.handleClick); }
  }
  if (!customElements.get('back-to-top')) customElements.define('back-to-top', BackToTop);
</script>

