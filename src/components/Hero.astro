---
import Icon from './Icon.astro';
---

<section class="hero container" id="hero" aria-labelledby="hero-title">
  <div
    class="hero__divider reveal reveal--1"
    aria-hidden="true"
  ></div>

  <div class="hero__content">
    <div class="hero__copy" data-scroll-copy>

      <p class="hero__intro reveal reveal--2">
        Hello, I'm
      </p>

      <h1 id="hero-title" class="hero__title reveal reveal--3">
        naujaan<span class="hero__dot">.</span>
      </h1>

      <p class="hero__tagline reveal reveal--4">
        Developer by passion.<br />
        <em>Creator by nature.</em>
      </p>

      <div class="hero__details reveal reveal--5">
        <p class="hero__description">
          I'm a 4th year student at a technical high school in Poland.
          I like to build cool projects, ranging from web apps to microcontroller software.
          I'm fluent with Python, C++, JavaScript and Java.

          Apart from tech, I'm a calisthenics passionate.
        </p>

        <a class="hero__link" href="/projects">
          Explore my work
          <span aria-hidden="true"><Icon /></span>
        </a>
      </div>

    </div>
  </div>

  <div
    class="hero__divider reveal reveal--6"
    aria-hidden="true"
  ></div>
</section>

<style>
  /* Layout */
  .hero {
    position: relative;
    top: 0;
    z-index: 2;

    height: 100svh;
    min-height: 100svh;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    isolation: isolate;
  }

  .hero__content {
    padding-block: clamp(24px, 5vh, 70px);
  }

  /*
   * Scroll animation
   * Optional animation target for ScrollTransition.astro
   */
  .hero__copy {
    opacity: 1;

    transform: none;
    transform-origin: center center;
  }

  /* Hello, I'm */
  .hero__intro {
    position: relative;
    z-index: 1;

    margin: 0 0 -0.3em;

    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(28px, 4vw, 36px);
    line-height: 1;

    color: var(--accent);
  }

  /* naujaan. */
  .hero__title {
    margin: 0 0 0 clamp(16px, 3.5vw, 56px);

    font-family: var(--font-primary);
    font-size: clamp(80px, 18vw, 260px);
    font-weight: 600;
    line-height: 0.92;
    letter-spacing: -0.1em;
    white-space: nowrap;

    color: var(--text);
  }

  .hero__dot {
    color: var(--accent);
  }

  /* Tagline */
  .hero__tagline {
    margin: 30px 0 0;

    font-size: clamp(16px, 2vw, 24px);
    font-weight: 400;
    letter-spacing: -0.03em;

    color: var(--text-soft);
  }

  .hero__tagline em {
    font-family: var(--font-serif);
    font-size: 1.2em;
    font-weight: 400;
    color: var(--text);
  }

  /* Description and CTA */
  .hero__details {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 40px;

    margin-top: 70px;
  }

  .hero__description {
    max-width: 430px;
    margin: 0;

    font-size: 14px;
    line-height: 1.9;
    color: var(--text-muted);
  }



  /* Entry animations */
  .reveal {
    opacity: 0;
    transform: translateY(24px);

    animation: revealUp 0.85s
      cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .reveal--1 { animation-delay: 0.05s; }
  .reveal--2 { animation-delay: 0.20s; }
  .reveal--3 { animation-delay: 0.35s; }
  .reveal--4 { animation-delay: 0.50s; }
  .reveal--5 { animation-delay: 0.65s; }
  .reveal--6 { animation-delay: 0.80s; }

  @keyframes revealUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .hero {
      min-height: calc(100svh - 120px);
    }

    .hero__content {
      padding-block: 90px;
    }

    .hero__intro {
      font-size: clamp(30px, 6vw, 42px);
      margin-bottom: -0.25em;
    }

    .hero__title {
      font-size: clamp(58px, 15.5vw, 120px);
      margin-left: clamp(8px, 2vw, 16px);
    }

    .hero__tagline {
      margin-top: 24px;
      line-height: 1.5;
    }

    .hero__details {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
      margin-top: 45px;
    }
  }

  @media (max-width: 380px) {
    .hero__title {
      font-size: 16vw;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .reveal {
      animation: none;
      opacity: 1;
      transform: none;
    }

    .hero__link {
      transition: none;
    }
  }

  @media (max-width: 768px),
         (prefers-reduced-motion: reduce) {
    .hero {
      position: relative;
      height: auto;
      min-height: calc(100svh - 100px);
    }

    .hero__copy {
      opacity: 1;
      transform: none;
    }
  }
</style>
