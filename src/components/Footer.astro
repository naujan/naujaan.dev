---
import { settings } from '../lib/site';
---
<footer class="container">
  <div class="footer-top">
    <p>Always curious.<br /><em>Always creating.</em></p>
    <nav aria-label="Footer">
      <a href="/blog/">Blog</a><a href="/projects/">Projects</a>
      {settings.github && <a href={settings.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
      {settings.linkedin && <a href={settings.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>}
      {settings.email && <a href={`mailto:${settings.email}`}>Get in touch ↗</a>}
    </nav>
  </div>
  <div class="footer-bottom"><a class="wordmark" href="/">naujaan.dev</a><span>{settings.footer}</span><span>© {new Date().getFullYear()}</span></div>
</footer>
<style>
  footer { padding-block: 80px 32px; }
  .footer-top { border-top: 1px solid var(--border); padding-top: 64px; display: flex; justify-content: space-between; gap: 40px; }
  .footer-top p { margin: 0; font-size: clamp(30px, 4vw, 60px); letter-spacing: -.045em; line-height: 1.1; }
  em { font-family: var(--font-serif); font-weight: 400; }
  nav { display: flex; flex-wrap: wrap; align-content: flex-start; gap: 20px; max-width: 380px; font-size: 13px; }
  a { color: inherit; text-decoration: none; } a:hover { color: #a8baff; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; margin-top: 100px; font-size: 11px; color: var(--text-muted); }
  .wordmark { font-family: var(--font-display); color: var(--text); }
  @media (max-width: 600px) { .footer-top { flex-direction: column; } .footer-bottom { margin-top: 60px; } }
</style>

