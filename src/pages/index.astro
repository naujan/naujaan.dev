
---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout overlayHeader>
  <div class="hero-stage" data-hero-stage>
    <Hero />
  </div>

  <section class="about" id="about" data-about>
    <div class="container">
      <h2>Beyond the code.</h2>

      <p>
        I'm a fourth-year student at a technical
        high school in Poland. I build web applications,
        primarily focusing on backend development.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* Header overlay — homepage only */
  :global(body.home-layout > header) {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    width: 100%;

    transform:
      translateY(var(--header-shift, 0%))
      scale(var(--header-scale, 1));

    transform-origin: top center;
    opacity: var(--header-opacity, 1);
  }

  /*
   * Sticky scene.
   * Longer scrolling distance with a short pause
   * between the header disappearing and About entering.
   */
  .hero-stage {
  position: relative;
  height: calc(235svh + 30px);
	}

	.about {
	position: relative;
	z-index: 3;

	margin-top: -110svh;
	min-height: 110svh;

	padding-block: clamp(120px, 15vh, 180px);

	/*background: var(--background);*/
	}

  .about h2 {
    margin: 24px 0 32px;

    font-size: clamp(48px, 8vw, 110px);
    line-height: 1;
    letter-spacing: -0.07em;
  }

  .about p {
    max-width: 550px;
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
  }

  /* Disable the cinematic effect on mobile */
  @media (max-width: 768px),
         (prefers-reduced-motion: reduce) {
    :global(body.home-layout > header) {
      position: relative;
      transform: none;
      opacity: 1;
    }

    .hero-stage {
      height: auto;
    }

    .about {
      margin-top: 0;
      min-height: auto;
    }
  }
</style>


<script>
  const stage = document.querySelector<HTMLElement>(
    '[data-hero-stage]'
  );

  const about = document.querySelector<HTMLElement>(
    '[data-about]'
  );

  const heroCopy = document.querySelector<HTMLElement>(
    '.hero__copy'
  );

  const header = document.querySelector<HTMLElement>(
    'body.home-layout > header'
  );

  const reducedMotion = window.matchMedia(
    '(prefers-reduced-motion: reduce)'
  );

  const desktop = window.matchMedia(
    '(min-width: 769px)'
  );

  const clamp = (value: number): number =>
    Math.min(Math.max(value, 0), 1);

  const smoothstep = (value: number): number =>
    value * value * (3 - 2 * value);

  if (stage && about && heroCopy) {

    const updateScroll = () => {

      // Disable effects on mobile / reduced motion
      if (!desktop.matches || reducedMotion.matches) {
        header?.style.setProperty('--header-shift', '0%');
        header?.style.setProperty('--header-scale', '1');
        header?.style.setProperty('--header-opacity', '1');

        heroCopy.style.transform = 'none';
        heroCopy.style.opacity = '1';

        if (header) header.inert = false;
        heroCopy.inert = false;

        return;
      }

      const scrollY = Math.max(window.scrollY, 0);
      const vh = window.innerHeight;

      /*
       * PHASE 1: HEADER
       * Disappears during first 30px.
       */
      const headerProgress = clamp(scrollY / 30);

      header?.style.setProperty(
        '--header-shift',
        `${-100 * headerProgress}%`
      );

      header?.style.setProperty(
        '--header-scale',
        String(1 - 0.08 * headerProgress)
      );

      header?.style.setProperty(
        '--header-opacity',
        String(1 - headerProgress)
      );

      if (header) {
        header.inert = headerProgress >= 0.99;
      }

      /*
       * PHASE 2: HERO TRANSITION
       *
       * Wait until About has entered the viewport
       * before animating the Hero.
       */
      const aboutTop = about.getBoundingClientRect().top;

      // About covers 10% -> animation starts
      const startTop = vh;

      // About covers 65% -> animation ends
      const endTop = vh * 0.15;

      const progress = clamp(
        (startTop - aboutTop) / (startTop - endTop)
      );

      const eased = smoothstep(progress);

      /*
       * PHASE 3: SCALE + FADE
       *
       * Scale:   1.00 -> 1.2
       * Opacity: 1.00 -> 0.00
       */
      const scale = 1 + 0.2 * eased;
      const opacity = 1 - eased;

      heroCopy.style.transform = `scale(${scale})`;
      heroCopy.style.opacity = String(opacity);

      heroCopy.inert = progress >= 0.99;
    };

    let ticking = false;

    const onScroll = () => {
      if (ticking) return;

      ticking = true;

      requestAnimationFrame(() => {
        updateScroll();
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, {
      passive: true
    });

    window.addEventListener('resize', onScroll);

    desktop.addEventListener('change', onScroll);
    reducedMotion.addEventListener('change', onScroll);

    updateScroll();
  }
</script>
