---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { publishedProjects } from '../../lib/content';
export async function getStaticPaths() {
  return (await publishedProjects()).map(project => ({ params: { id: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<Layout title={`${project.data.title} — naujaan`} description={project.data.description}>
  <article class="container article">
    <a class="text-link" href="/projects/">← All projects</a>
    <p class="eyebrow">{project.data.year} {project.data.sample && ' / Sample project'}</p>
    <h1>{project.data.title}</h1><p class="article-summary">{project.data.description}</p>
    <div class="project-links">
      {project.data.repository && <a class="text-link" href={project.data.repository} target="_blank" rel="noopener noreferrer">Source code ↗</a>}
      {project.data.demo && <a class="text-link" href={project.data.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>}
    </div>
    {project.data.cover && <img class="article-cover" src={project.data.cover} alt={project.data.coverAlt} width="1200" height="750" />}
    <div class="prose"><Content /></div>
  </article>
</Layout>

